{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "reviewId": {
      "type": "string",
      "description": "HolidayCheck review identifier."
    },
    "hotelId": {
      "type": "string",
      "description": "HolidayCheck hotel identifier."
    },
    "hotelName": {
      "type": "string"
    },
    "reviewUrl": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "overallRating": {
      "type": [
        "number",
        "null"
      ],
      "description": "Overall review rating normalized to the HolidayCheck 1-10 display scale."
    },
    "recommendation": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "verifiedReservation": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "entryDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "travelDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "travelerType": {
      "type": [
        "string",
        "null"
      ]
    },
    "originalLanguage": {
      "type": [
        "string",
        "null"
      ]
    },
    "returnedLanguage": {
      "type": [
        "string",
        "null"
      ]
    },
    "hotel": {
      "type": "object"
    },
    "reviewer": {
      "type": "object"
    },
    "ownerResponse": {
      "type": [
        "object",
        "null"
      ]
    },
    "topics": {
      "type": "array"
    },
    "nativeRatings": {
      "type": "object"
    },
    "aspectScores": {
      "type": [
        "object",
        "null"
      ]
    },
    "aiAspectScores": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional full-text AI scores with exact-substring evidence."
    },
    "aiAspectError": {
      "type": [
        "string",
        "null"
      ]
    },
    "hybridAspectScores": {
      "type": [
        "object",
        "null"
      ],
      "description": "Final per-aspect score combining available native and AI evidence."
    },
    "anomalySignals": {
      "type": [
        "object",
        "null"
      ]
    },
    "translation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional English translation, its status, and the model used."
    },
    "competitorSetRef": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hotel ID used to locate this hotel's set in the COMPETITOR_SETS key-value record."
    },
    "rawContributions": {
      "type": [
        "object",
        "null"
      ]
    },
    "sourceUrl": {
      "type": "string"
    },
    "scrapedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "reviewId",
    "hotelId",
    "hotelName",
    "reviewUrl",
    "hotel",
    "reviewer",
    "topics",
    "nativeRatings",
    "sourceUrl",
    "scrapedAt"
  ]
}
